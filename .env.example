# ==========================================
# GovConnect Backend Environment Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/govconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/govconnect

# JWT Token Secrets (Generate random 64-character strings for production)
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# Legacy Session Secret (Used if running root MVC application)
SECRET=your_super_secret_session_key_here

# Google Gemini AI API Key (For multilingual assistant & Gazette parsing)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP for Real Email OTPs (Optional - Falls back to console log in dev)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Fast2SMS for Indian Phone OTPs (Optional - Falls back to console log in dev)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Cloudinary (Optional - For citizen document uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
