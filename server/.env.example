# ==========================================
# GovConnect MERN REST API Environment Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas required for Render production)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/govconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/govconnect

# JWT Token Secrets (Use high-entropy strings in production)
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP for Real Email OTP (Optional - Falls back to console log)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Fast2SMS for Indian Phone OTP (Optional - Falls back to console log)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
