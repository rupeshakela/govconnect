<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'GovScheme Portal - Sarkari Yojana & Career Navigator' %></title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Custom Theme & Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="gov-theme">
  <!-- Top Global Navigation Bar -->
  <%- include("../includes/navbar.ejs") %>

  <!-- Main Content Container -->
  <main class="gov-main-content">
    <div class="container py-4">
      <%- include("../includes/flash.ejs") %>
      <%- body %>
    </div>
  </main>

  <!-- Interactive AI Mitra Chatbot -->
  <%- include("../includes/chatbot.ejs") %>

  <!-- Global Footer -->
  <%- include("../includes/footer.ejs") %>

  <!-- Bootstrap 5.3 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Custom Application Logic (Multilingual, Voice, Chatbot, Bookmarks) -->
  <script src="/js/script.js"></script>
</body>
</html>
