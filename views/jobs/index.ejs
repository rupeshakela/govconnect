<% layout("/layouts/boilerplate") %>

<!-- Real-time Autonomous Government Job & Gazette Ingestion Ticker -->
<div class="live-sync-banner mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-sm">
  <div class="d-flex align-items-center gap-2">
    <span class="status-indicator-dot"></span>
    <div>
      <strong class="text-white">Live Government Jobs & Exams Auto-Sync: ACTIVE</strong>
      <span class="text-light ms-1 d-none d-md-inline">&bull; Connected directly to UPSC, SSC, RRB & State Gazette feeds. New vacancies reflect automatically.</span>
    </div>
  </div>
  <div class="d-flex align-items-center gap-2 small">
    <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
      <i class="fa-solid fa-bolt me-1"></i> Autonomous Ingestion (Every 15m)
    </span>
    <% if (typeof syncStatus !== 'undefined' && syncStatus.lastSyncTime) { %>
      <span class="text-muted small d-none d-lg-inline">
        Last Checked: <%= new Date(syncStatus.lastSyncTime).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
      </span>
    <% } %>
  </div>
</div>

<!-- Header Section -->
<div class="gov-hero-section text-center py-4 mb-4 position-relative rounded-4 overflow-hidden">
  <div class="gov-hero-bg-glow"></div>
  <div class="position-relative z-1">
    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-1 rounded-pill mb-2 fw-bold">
      <i class="fa-solid fa-bullhorn me-1"></i> Live Government Recruitment Portal
    </span>
    <h1 class="display-6 fw-bold text-light mb-2" data-i18n="jobsTitle">
      Government Jobs & National Competitive Exams
    </h1>
    <p class="text-muted max-w-700 mx-auto mb-0" data-i18n="jobsSubtitle">
      Real-time notifications from UPSC, SSC, Railway Recruitment Board (RRB), IBPS, and State Commissions.
    </p>
  </div>
</div>

<!-- Tabs & Filters Nav -->
<div class="card bg-darker border-secondary border-opacity-25 rounded-4 p-3 mb-4 shadow-sm">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
    <!-- Tab Pill Buttons -->
    <ul class="nav nav-pills gov-pills gap-2" id="jobsExamsTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link <%- currentTab !== 'exams' ? 'active' : '' %>" id="jobs-tab" data-bs-toggle="tab" data-bs-target="#jobs-content" type="button" role="tab">
          <i class="fa-solid fa-briefcase me-2"></i> Sarkari Jobs <span class="badge bg-primary ms-1"><%= jobs.length %></span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link <%- currentTab === 'exams' ? 'active' : '' %>" id="exams-tab" data-bs-toggle="tab" data-bs-target="#exams-content" type="button" role="tab">
          <i class="fa-solid fa-graduation-cap me-2"></i> Competitive Exams <span class="badge bg-info ms-1"><%= exams.length %></span>
        </button>
      </li>
    </ul>

    <!-- Filter Form -->
    <form action="/jobs" method="GET" class="d-flex gap-2 flex-grow-1 max-w-500 ms-auto">
      <input type="text" name="search" class="form-control gov-input form-control-sm" placeholder="Search post or department..." value="<%= searchQuery %>">
      <button type="submit" class="btn btn-primary-gradient btn-sm px-3">Search</button>
    </form>
  </div>
</div>

<!-- Tab Content Panes -->
<div class="tab-content" id="jobsExamsTabContent">
  <!-- 1. Jobs Pane -->
  <div class="tab-pane fade <%- currentTab !== 'exams' ? 'show active' : '' %>" id="jobs-content" role="tabpanel">
    <% if (jobs.length === 0) { %>
      <div class="card border-0 text-center py-5 rounded-4 gov-empty-card">
        <div class="empty-icon mb-3">🏢</div>
        <h4 class="text-light fw-bold">No Active Job Notifications</h4>
        <p class="text-muted">No vacancies found matching your search.</p>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% for (let job of jobs) { %>
          <div class="col-md-6 col-lg-6">
            <div class="card job-card h-100 rounded-4 border-0 shadow-sm p-4 d-flex flex-column">
              <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">
                  <%= job.department %>
                </span>
                <% if (job.state) { %>
                  <span class="badge bg-secondary text-white small"><%= job.state.name %></span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success small fw-bold">Central Post</span>
                <% } %>
              </div>

              <h5 class="fw-bold text-light mb-2"><%= job.postName %></h5>

              <!-- Job Key Metrics -->
              <div class="row g-2 text-muted small my-2">
                <div class="col-6">
                  <span class="d-block text-secondary" data-i18n="jobVacancies">Total Vacancies</span>
                  <strong class="text-warning fs-6"><%= job.vacancies > 0 ? job.vacancies.toLocaleString() + ' Posts' : 'As per notice' %></strong>
                </div>
                <div class="col-6">
                  <span class="d-block text-secondary" data-i18n="jobSalary">Salary Scale</span>
                  <strong class="text-success fs-6"><%= job.salaryRange %></strong>
                </div>
                <div class="col-12">
                  <span class="d-block text-secondary" data-i18n="jobQualification">Educational Qualification</span>
                  <span class="text-light fw-semibold"><%= job.qualification %></span>
                </div>
                <div class="col-12">
                  <span class="d-block text-secondary" data-i18n="jobLastDate">Application Deadline</span>
                  <span class="text-danger fw-bold">
                    <i class="fa-regular fa-calendar-xmark me-1"></i> <%= new Date(job.lastDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </span>
                </div>
              </div>

              <div class="mt-auto pt-3 border-top border-dark d-flex justify-content-between align-items-center">
                <small class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Auto-Synced Notification</small>
                <a href="<%= job.officialNotification %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info btn-sm">
                  <span data-i18n="jobNotification">Official Notice</span> <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- 2. Exams Pane -->
  <div class="tab-pane fade <%- currentTab === 'exams' ? 'show active' : '' %>" id="exams-content" role="tabpanel">
    <% if (exams.length === 0) { %>
      <div class="card border-0 text-center py-5 rounded-4 gov-empty-card">
        <div class="empty-icon mb-3">🎯</div>
        <h4 class="text-light fw-bold">No Competitive Exams Found</h4>
        <p class="text-muted">No examination schedules match your query.</p>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% for (let exam of exams) { %>
          <div class="col-md-6 col-lg-6">
            <div class="card job-card h-100 rounded-4 border-0 shadow-sm p-4 d-flex flex-column">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-bold">
                  <%= exam.conductingAuthority %>
                </span>
                <span class="badge bg-dark border border-secondary text-secondary">Fee: ₹<%= exam.fees %></span>
              </div>

              <h5 class="fw-bold text-light mb-2"><%= exam.name %></h5>

              <div class="row g-2 text-muted small my-2">
                <div class="col-12">
                  <span class="d-block text-secondary">Schedule & Important Dates</span>
                  <span class="text-light fw-semibold"><%= exam.importantDates %></span>
                </div>
                <div class="col-12">
                  <span class="d-block text-secondary">Eligibility Norms</span>
                  <span class="text-light"><%= exam.eligibility %></span>
                </div>
                <div class="col-12">
                  <span class="d-block text-secondary">Exam Pattern & Syllabus</span>
                  <span class="text-light"><%= exam.syllabus %></span>
                </div>
              </div>

              <div class="mt-auto pt-3 border-top border-dark d-flex justify-content-between align-items-center">
                <small class="text-info"><i class="fa-solid fa-shield me-1"></i> National Exam</small>
                <a href="<%= exam.officialWebsite %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-warning btn-sm">
                  Official Portal <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
