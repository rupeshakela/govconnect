<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-4">
  <div class="col-md-8 col-lg-6 col-xl-5">
    <div class="card auth-card border-0 rounded-4 shadow-2xl p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="auth-icon mb-2">🔑</div>
        <h3 class="fw-bold text-light mb-1">Reset Password</h3>
        <p class="text-muted small">Recover access to your citizen portal account</p>
      </div>

      <% if (step === 1) { %>
        <!-- Step 1: Identifier -->
        <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
          <div class="mb-4">
            <label class="form-label text-light fw-semibold small">Registered Email or Mobile *</label>
            <div class="input-group">
              <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-regular fa-envelope"></i></span>
              <input type="text" name="identifier" class="form-control gov-input border-secondary" placeholder="ramesh@example.com or 9876543210" required autofocus>
            </div>
            <div class="invalid-feedback">Enter your registered email or mobile.</div>
          </div>

          <button type="submit" class="btn btn-primary-gradient w-100 py-2 fw-semibold">
            Send Reset OTP <i class="fa-solid fa-arrow-right ms-1"></i>
          </button>
        </form>
      <% } else { %>
        <!-- Step 2: OTP + New Password -->
        <% if (devOtp) { %>
          <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3">
            <strong>Developer Hint:</strong> Your reset OTP code is <code class="fw-bold fs-6"><%= devOtp %></code>
          </div>
        <% } %>

        <form action="/forgot-password/reset" method="POST" class="needs-validation" novalidate>
          <input type="hidden" name="userId" value="<%= userId %>">

          <div class="mb-3">
            <label class="form-label text-light fw-semibold small">6-Digit Reset OTP *</label>
            <input type="text" name="otp" class="form-control gov-input text-center fs-4 letter-spacing-lg" placeholder="••••••" maxlength="6" value="<%= devOtp || '' %>" required autofocus>
            <div class="invalid-feedback">Enter the 6-digit OTP code.</div>
          </div>

          <div class="mb-3">
            <label class="form-label text-light fw-semibold small">New Password *</label>
            <input type="password" name="newPassword" class="form-control gov-input" placeholder="Minimum 6 characters" minlength="6" required>
            <div class="invalid-feedback">Password must be at least 6 characters.</div>
          </div>

          <div class="mb-4">
            <label class="form-label text-light fw-semibold small">Confirm New Password *</label>
            <input type="password" name="confirmNewPassword" class="form-control gov-input" placeholder="Repeat new password" minlength="6" required>
            <div class="invalid-feedback">Confirm your new password.</div>
          </div>

          <button type="submit" class="btn btn-primary-gradient w-100 py-2 fw-semibold">
            Set New Password & Log In
          </button>
        </form>
      <% } %>

      <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
        <a href="/login" class="text-muted small text-decoration-none hover-accent">&larr; Back to Login</a>
      </div>
    </div>
  </div>
</div>
