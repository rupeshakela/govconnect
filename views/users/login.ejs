<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-4">
  <div class="col-md-8 col-lg-6 col-xl-5">
    <div class="card auth-card border-0 rounded-4 shadow-2xl p-4 p-md-5">
      <!-- Title -->
      <div class="text-center mb-4">
        <div class="auth-icon mb-2">🏛️</div>
        <h3 class="fw-bold text-light mb-1">Citizen Login</h3>
        <p class="text-muted small">Access your verified profile, saved schemes and applications</p>
      </div>

      <!-- Login Form -->
      <form action="/login" method="POST" class="needs-validation" novalidate>
        <!-- Identifier (Email, Mobile, or Username) -->
        <div class="mb-3">
          <label class="form-label text-light fw-semibold small">Email Address / Mobile / Username *</label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-regular fa-user"></i></span>
            <input type="text" name="username" class="form-control gov-input border-secondary" placeholder="ramesh@example.com or 9876543210" required autofocus>
          </div>
          <div class="invalid-feedback">Please enter your username, email or mobile number.</div>
        </div>

        <!-- Password -->
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label text-light fw-semibold small mb-0">Password *</label>
            <a href="/forgot-password" class="text-accent small text-decoration-none">Forgot Password?</a>
          </div>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-lock"></i></span>
            <input type="password" name="password" class="form-control gov-input border-secondary" placeholder="Enter your password" required>
          </div>
          <div class="invalid-feedback">Password is required.</div>
        </div>

        <button type="submit" class="btn btn-primary-gradient w-100 py-2 fw-semibold mt-2">
          <i class="fa-solid fa-right-to-bracket me-1"></i> Log In to Portal
        </button>
      </form>

      <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
        <p class="text-muted small mb-0">Don't have an account yet? <a href="/signup" class="text-accent text-decoration-none fw-semibold">Register here</a></p>
      </div>
    </div>
  </div>
</div>
